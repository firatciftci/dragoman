{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "svelte": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "objectWrap": "collapse",
  "sortTailwindcss": {
    "stylesheet": "./extension/src/app.css",
    "functions": ["tv", "cn", "tw"]
  },
  "ignorePatterns": [
    "node_modules",
    "pnpm-lock.yaml",
    ".output",
    ".wxt",
    ".svelte-kit",
    "build",
    "public",
    "static",
    "assets",
    "**/paraglide",
    "project.inlang"
  ]
}
