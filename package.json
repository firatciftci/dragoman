{
  "name": "dragoman",
  "description": "Page translation for every browser: instant local drafts, refined by the AI model of your choice",
  "version": "1.0.4",
  "private": true,
  "license": "MIT",
  "author": "Firat Ciftci (https://www.firatciftci.com)",
  "homepage": "https://dragoman.io",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev:extension": "pnpm --filter @dragoman/extension dev",
    "dev:site": "pnpm --filter @dragoman/site dev",
    "dev:studio": "pnpm --filter @dragoman/brand studio",
    "build": "pnpm --recursive --workspace-concurrency=1 run build",
    "postinstall": "pnpm run compile-paraglide",
    "render-brand": "pnpm --filter @dragoman/brand render",
    "compile-paraglide": "paraglide-js compile --project ./project.inlang --outdir ./extension/src/lib/paraglide --strategy globalVariable preferredLanguage baseLocale && paraglide-js compile --project ./project.inlang --outdir ./site/src/lib/paraglide --strategy url baseLocale --output-structure locale-modules",
    "translate-messages": "node scripts/translate-messages.ts",
    "check": "pnpm --recursive --workspace-concurrency=1 run check",
    "lint": "knip && SVELTE_ESLINT_PARSER_EXPERIMENTAL_TS_SYS_HOOK=1 eslint . && pnpm --recursive --workspace-concurrency=1 run lint",
    "lint:fix": "knip --fix && SVELTE_ESLINT_PARSER_EXPERIMENTAL_TS_SYS_HOOK=1 eslint --fix . && pnpm --recursive --workspace-concurrency=1 run lint:fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "release": "bumpp"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "@dragoman/brand": "workspace:*",
    "@inlang/paraglide-js": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-erasable-syntax-only": "catalog:",
    "eslint-plugin-inline-utilities": "catalog:",
    "eslint-plugin-slop": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
